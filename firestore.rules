rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function owner(uid){return signedIn() && request.auth.uid == uid;}
  function admin(){return signedIn() && request.auth.token.admin == true;}
  match /users/{uid} {
   allow create: if owner(uid) && request.resource.data.uid == uid && request.resource.data.plan == 'free' && request.resource.data.keys().hasOnly(['uid','displayName','email','stream','plan','createdAt','updatedAt']);
   allow read: if owner(uid) || admin();
   allow update: if owner(uid) && request.resource.data.uid == resource.data.uid && request.resource.data.plan == resource.data.plan && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','stream','updatedAt']);
   allow delete: if admin();
  }
  match /content/{contentId} {
   allow read: if resource.data.status == 'published' || admin();
   allow create, update, delete: if admin();
  }
  match /curricula/{curriculumId} {
   allow read: if resource.data.status == 'published' || admin();
   allow create, update, delete: if admin();
  }
  match /researchPapers/{paperId} {
   allow read: if resource.data.status == 'published' || admin();
   allow create, update, delete: if admin();
  }
  match /researchSubmissions/{submissionId} {
   allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid && request.resource.data.status == 'submitted';
   allow read: if (signedIn() && resource.data.authorUid == request.auth.uid) || admin();
   allow update, delete: if admin();
  }
  match /usage/{uid}/{path=**} {allow read: if owner(uid) || admin(); allow write: if false;}
  match /adminAudit/{path=**} {allow read: if admin(); allow write: if false;}
  match /{path=**} {allow read,write: if false;}
 }
}